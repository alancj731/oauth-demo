{
  "name": "oauth-flow-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Step-by-step OAuth 2.0 / OpenID Connect demo that shows every HTTP request between the parties.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "start": "tsx src/dev.ts",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@upstash/redis": "^1.41.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "jose": "^6.2.15"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
