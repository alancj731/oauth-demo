# All optional. With nothing set the app runs locally with in-memory state.

# Public base URL of the app. Becomes the OAuth issuer (APP_ORIGIN + /auth).
# On Vercel it defaults to https://$VERCEL_PROJECT_PRODUCTION_URL.
# APP_ORIGIN=http://localhost:3000

# Shared state (needed on Vercel). Set automatically when you add
# Upstash Redis from the Vercel Marketplace.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN also work)

# Optional fixed RS256 signing key (private JWK as JSON). If unset, a key is
# generated once and saved in the store.
# OAUTH_PRIVATE_JWK=
